{
  "name": "dottie-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "simulate": "tsx scripts/predictor-simulation.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:adaptive": "tsx scripts/adaptive-quiz-harness.ts",
    "test:rhythm": "tsx scripts/gentle-rhythm-harness.ts",
    "test:predictor": "tsx scripts/predictor-scenarios-harness.ts",
    "test:journey": "tsx scripts/app-journey-harness.ts",
    "test:explainer": "tsx scripts/prediction-explainer-harness.ts",
    "audit:ui": "tsx scripts/ui-onpress-audit.ts",
    "test:all": "npm run type-check && npm run validate:content && npm run test:adaptive && npm run test:rhythm && npm run test:predictor && npm run test:journey && npm run test:explainer && npm run test:sister && npm run test:blocks && npm run test:dedupe && npm run test:diag && npm run test:creature && npm run audit:ui",
    "test:sister": "tsx scripts/sister-overlay-harness.ts",
    "test:blocks": "tsx scripts/period-blocks-harness.ts",
    "test:dedupe": "tsx scripts/reminder-dedupe-harness.ts",
    "test:diag": "tsx scripts/diagnostics-harness.ts",
    "test:creature": "tsx scripts/creature-harness.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "lottie-react-native": "7.1.0",
    "lucide-react-native": "^0.460.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "~15.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.6.0"
  }
}
