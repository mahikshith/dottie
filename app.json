{
  "expo": {
    "name": "Dottie",
    "slug": "dottie-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dottie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A16"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dottie.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Dottie uses health data to improve cycle predictions"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0A16"
      },
      "package": "com.dottie.app"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0C0A16",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0C0A16"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "//": "useSQLCipher makes the native build link SQLCipher so PRAGMA key actually encrypts the DB at rest (B2 Step 2). Stock expo-sqlite silently ignores PRAGMA key.",
          "useSQLCipher": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
